{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{GatewayTraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "units": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/units/{**catch-all}"
        }
      },
      "teams": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/teams/{**catch-all}"
        }
      },
      "permission-groups": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/permission-groups/{**catch-all}"
        }
      },
      "features": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/features/{**catch-all}"
        }
      },
      "audit-logs": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/audit-logs/{**catch-all}"
        }
      },
      "settings": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/settings/{**catch-all}"
        }
      },
      "ip-whitelist": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/ip-whitelist/{**catch-all}"
        }
      },
      "ip-access-logs": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/ip-access-logs/{**catch-all}"
        }
      },
      "project-tasks-create": {
        "ClusterId": "tasks",
        "Order": -10,
        "Match": {
          "Path": "/api/projects/{projectId}/tasks",
          "Methods": [
            "POST"
          ]
        }
      },
      "projects": {
        "ClusterId": "projects",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "tasks": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      },
      "time-logs": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/time-logs/{**catch-all}"
        }
      },
      "report-previews": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/report-previews"
        }
      },
      "notifications": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "review-queue": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/review-queue"
        }
      },
      "reports": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "attachments": {
        "ClusterId": "tasks",
        "Match": {
          "Path": "/api/attachments/{**catch-all}"
        }
      },
      "dashboard": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/dashboard"
        }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        }
      },
      "alerts": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/alerts/{**catch-all}"
        }
      },
      "jobs": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/jobs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "projects": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "tasks": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      }
    }
  }
}
