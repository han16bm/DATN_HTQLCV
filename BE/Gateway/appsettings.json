{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "datn-identity",
    "Audience": "datn-clients",
    "SigningKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "units": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/units/{**catch-all}" }
      },
      "teams": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/teams/{**catch-all}" }
      },
      "project-tasks-create": {
        "ClusterId": "tasks",
        "Order": -10,
        "Match": { "Path": "/api/projects/{projectId}/tasks", "Methods": [ "POST" ] }
      },
      "projects": {
        "ClusterId": "projects",
        "Match": { "Path": "/api/projects/{**catch-all}" }
      },
      "tasks": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/tasks/{**catch-all}" }
      },
      "time-logs": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/time-logs/{**catch-all}" }
      },
      "report-previews": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/report-previews" }
      },
      "reports": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "attachments": {
        "ClusterId": "tasks",
        "Match": { "Path": "/api/attachments/{**catch-all}" }
      },
      "dashboard": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/dashboard" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "alerts": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/alerts/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101" }
        }
      },
      "projects": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102" }
        }
      },
      "tasks": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5103" }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5104" }
        }
      }
    }
  }
}
