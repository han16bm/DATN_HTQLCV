{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=Require"
  },
  "Jwt": {
    "SigningKey": "<chuỗi ngẫu nhiên ≥ 32 ký tự>"
  },
  "CentralConfig": {
    "ReloadSeconds": 30
  },
  "Storage": {
    "Provider": "Auto",
    "PublicBaseUrl": "http://localhost:5000",
    "LocalRoot": "App_Data/storage",
    "Cloudinary": {
      "CloudName": "<cloud name>",
      "ApiKey": "<api key>",
      "ApiSecret": "<api secret — để trống thì lưu đĩa cục bộ>",
      "Folder": "datn"
    }
  }
}
